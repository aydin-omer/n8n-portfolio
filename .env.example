# Copy this file:  cp .env.example .env
# Then fill in the values. Never commit .env.

# Generate a key with:  openssl rand -hex 32
# Store it somewhere safe; without it, saved credentials cannot be decrypted.
N8N_ENCRYPTION_KEY=replace-with-a-long-random-key

# Your timezone (e.g. Europe/Istanbul, America/New_York)
GENERIC_TIMEZONE=Europe/Istanbul
TZ=Europe/Istanbul
