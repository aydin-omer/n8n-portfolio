      "id": "dd28b27e-4447-4e87-a769-dc00955d5763",
      "name": "Fetch KEV Catalog",
      "retryOnFail": true,
      "waitBetweenTries": 2000
    },
    {
      "parameters": {
        "jsCode": "const cveId = $('When Executed by Another Workflow').first().json.cveId.trim().toUpperCase();\nconst catalog = $input.first().json;\nconst entry = (catalog.vulnerabilities ?? []).find(v => v.cveID === cveId);\n\n// Absence from KEV is not proof of safety, so the message says exactly that\nif (!entry) {\n  return [{\n    json: {\n      cveId,\n      inKev: false,\n      catalogVersion: catalog.catalogVersion,\n      message: 'Not in the CISA KEV catalog. CISA has not confirmed exploitation in the wild, which does not prove it is not exploited.',\n    },\n  }];\n}\n\nreturn [{\n  json: {\n    cveId,\n    inKev: true,\n    vendor: entry.vendorProject,\n    product: entry.product,\n    name: entry.vulnerabilityName,\n    dateAdded: entry.dateAdded,\n    dueDate: entry.dueDate,\n    ransomwareUse: entry.knownRansomwareCampaignUse,   // \"Known\" or \"Unknown\"\n    requiredAction: entry.requiredAction,\n    catalogVersion: catalog.catalogVersion,\n  },\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
        0
      ],
      "id": "0b20ceee-184e-4eb4-b352-f5f37c399999",
