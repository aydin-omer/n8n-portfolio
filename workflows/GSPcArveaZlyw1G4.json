    {
      "parameters": {
        "jsCode": "const r = $('Apply Priority Rules').first().json;\n\nconst labels = {\n  P1: '🚨 P1 · fix immediately',\n  P2: '⚠️ P2 · fix this week',\n  P3: 'P3 · normal patch cycle',\n  P4: 'P4 · low',\n};\nconst fix = r.fixedVersions.length\n  ? r.fixedVersions.join(', ')\n  : (r.advisoryUrl ?? 'no fix information found');\n\nconst lines = [\n  `**${labels[r.priority]}: ${r.cveId}**`,\n  r.whatItIs,\n  '',\n  `**Why:** ${r.reason}`,\n  `**Affected:** ${r.affected.join(', ') || 'unknown'}`,\n  `**Fix:** ${fix}`,\n  `<https://nvd.nist.gov/vuln/detail/${r.cveId}>`,\n];\n\n// Be transparent when the rules overruled the model or data was missing\nif (r.priorityOverridden) lines.push(`_Priority set by the rules. The model suggested ${r.llmPriority}._`);\nif (r.missingTools.length) lines.push(`_Missing data: ${r.missingTools.join(', ')}_`);\n\n// Keep room for the acknowledge link so it is never cut off by the length limit\nlet message = lines.join('\\n').slice(0, 1800);\n\n// $execution.resumeUrl is the link that wakes up the Wait node of this execution\nif (r.priority === 'P1') {\n  message += `\\n\\n[✅ Acknowledge](<${$execution.resumeUrl}>)`;\n}\n\nreturn [{\n  json: {\n    cveId: r.cveId,\n    priority: r.priority,\n    message,\n  },\n}];"
      },
      "type": "n8n-nodes-base.code",
