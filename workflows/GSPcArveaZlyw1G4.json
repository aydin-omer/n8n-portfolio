    {
      "parameters": {
        "jsCode": "const cveId = $('On form submission').first().json['CVE ID'].trim().toUpperCase();\nconst raw = String($input.first().json.output ?? '');\n\n// Local models sometimes wrap the JSON in code fences or add a sentence around it,\n// so we take everything between the first \"{\" and the last \"}\"\nconst start = raw.indexOf('{');\nconst end = raw.lastIndexOf('}');\nif (start === -1 || end <= start) {\n  throw new Error(`Agent did not return a JSON object for ${cveId}: ${raw.slice(0, 200)}`);\n}\n\nlet r;\ntry {\n  r = JSON.parse(raw.slice(start, end + 1));\n} catch (e) {\n  throw new Error(`Agent returned invalid JSON for ${cveId}: ${e.message}`);\n}\n\nif (!['P1', 'P2', 'P3', 'P4'].includes(r.priority)) {\n  throw new Error(`Invalid priority \"${r.priority}\" for ${cveId}`);\n}\n\n// Small type slips are repaired instead of failing the whole run\nconst toList = v => (Array.isArray(v) ? v.map(String) : v ? [String(v)] : []);\nconst toNumberOrNull = v =>\n  v === null || v === undefined || v === '' || isNaN(Number(v)) ? null : Number(v);\nconst s = r.signals ?? {};\n\nreturn [{\n  json: {\n    cveId,                                   // from the form, never from the model\n    priority: r.priority,\n    reason: String(r.reason ?? ''),\n    whatItIs: String(r.whatItIs ?? ''),\n    affected: toList(r.affected).slice(0, 5),\n    fixedVersions: toList(r.fixedVersions),\n    advisoryUrl: r.advisoryUrl ? String(r.advisoryUrl) : null,\n    signals: {\n      cvssScore: toNumberOrNull(s.cvssScore),\n      epss: toNumberOrNull(s.epss),\n      inKev: s.inKev === true,\n      hasExploitReference: s.hasExploitReference === true,\n    },\n    dataGaps: toList(r.dataGaps),\n    triagedAt: new Date().toISOString(),\n  },\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        592,
        0
      ],
      "id": "8c41e441-5bee-4abb-a623-9620ecd41a7c",
      "name": "Parse & Validate"
    },
    {
      "parameters": {
        "jsCode": "const steps = $('AI Agent').first().json.intermediateSteps ?? [];\nconst result = $input.first().json;\n\n// Tool results arrive as JSON strings. Use the last call of each tool.\nconst toolResult = (name) => {\n  const step = [...steps].reverse().find(s => s.action?.tool === name);\n  if (!step) return null;\n  try {\n    let data = typeof step.observation === 'string' ? JSON.parse(step.observation) : step.observation;\n    if (Array.isArray(data)) data = data[0];\n    return data?.json ?? data ?? null;\n  } catch {\n    return null;\n  }\n};\n\nconst nvd = toolResult('get_nvd_details');\nconst epss = toolResult('get_epss_score');\nconst kev = toolResult('check_cisa_kev');\n\n// Signals come straight from the tools, not from what the model copied\nconst signals = {\n  cvssScore: nvd?.found ? (nvd.cvssScore ?? null) : null,\n  epss: epss?.found ? epss.epss : null,\n  inKev: kev?.inKev === true,\n  hasExploitReference: nvd?.hasExploitReference === true,\n};\n\n// The same rules as in the system prompt, evaluated in code\nconst c = signals.cvssScore;\nconst e = signals.epss;\nlet rulePriority;\nif (signals.inKev || (c >= 9 && e >= 0.1)) rulePriority = 'P1';\nelse if (e >= 0.1 || (c >= 7 && (e >= 0.01 || signals.hasExploitReference))) rulePriority = 'P2';\nelse if (c >= 7 || (c >= 4 && e >= 0.01) || (c === null && e === null)) rulePriority = 'P3';\nelse rulePriority = 'P4';\n\nconst allTools = ['get_nvd_details', 'get_epss_score', 'check_cisa_kev', 'get_osv_packages'];\nconst missingTools = allTools.filter(t => !steps.some(s => s.action?.tool === t));\n\nreturn [{\n  json: {\n    ...result,\n    priority: rulePriority,\n    llmPriority: result.priority,\n    priorityOverridden: result.priority !== rulePriority,\n    signals,\n    missingTools,\n  },\n}];"
      },
