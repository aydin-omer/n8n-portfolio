      "id": "b4d0baed-aa66-4830-9aad-5190d4936816",
      "name": "Error Trigger"
    },
    {
      "parameters": {
        "jsCode": "const data = $input.first().json;\nconst workflowName = data.workflow?.name ?? 'unknown workflow';\nconst exec = data.execution ?? {};\n\n// If the trigger itself fails, n8n sends the error under \"trigger\" instead of \"execution\"\nconst error = exec.error ?? data.trigger?.error ?? {};\n\nconst message = [\n  `🔥 **Workflow failed: ${workflowName}**`,\n  `**Node:** ${exec.lastNodeExecuted ?? 'trigger'}`,\n  `**Error:** ${error.message ?? 'no error message'}`,\n  exec.url ? `<${exec.url}>` : '',\n]\n  .filter(Boolean)\n  .join('\\n')\n  .slice(0, 1900);\n\nreturn [{ json: { message } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        224,
        0
      ],
      "id": "d4546281-e3a9-4607-a9ba-2a3f77fc50f2",
      "name": "Build Error Message"
    },
