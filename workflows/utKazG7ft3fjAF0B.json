      "name": "Fetch NVD CVEs",
      "credentials": {
        "httpHeaderAuth": {
          "id": "xAP2QgbJiC9jYUx9",
          "name": "NVD API Key"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// ===== Settings =====\nconst MIN_SCORE = 7.0; // HIGH and CRITICAL only\n\n// ===== Helper: pick the newest CVSS version available =====\nconst pickMetric = (m = {}) =>\n  m.cvssMetricV40?.[0] ?? m.cvssMetricV31?.[0] ?? m.cvssMetricV30?.[0] ?? null;\n\n// ===== One clean item per relevant CVE =====\nconst vulns = $input.first().json.vulnerabilities ?? [];\n\nreturn vulns\n  .map(({ cve }) => {\n    const metric = pickMetric(cve.metrics);\n    return {\n      json: {\n        id: cve.id,\n        status: cve.vulnStatus,\n        published: cve.published,\n        score: metric?.cvssData?.baseScore ?? null,\n        severity: metric?.cvssData?.baseSeverity ?? 'UNKNOWN',\n        cvssVersion: metric?.cvssData?.version ?? null,\n        description: cve.descriptions?.find(d => d.lang === 'en')?.value ?? '',\n        url: `https://nvd.nist.gov/vuln/detail/${cve.id}`,\n      },\n    };\n  })\n  .filter(({ json }) =>\n    json.status !== 'Rejected' && json.score !== null && json.score >= MIN_SCORE\n  );"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
        0
      ],
      "id": "28b92c36-137d-4e31-9187-a8da05b3f9f8",
      "name": "Parse & Filter"
    },
